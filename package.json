{
  "name": "petlink-web",
  "private": true,
  "version": "0.2.1-collar.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"vite --port 5178\" \"wait-on tcp:5178 && cross-env ELECTRON_START_URL=http://localhost:5178/?mini=1 electron .\"",
    "electron:build": "cross-env VITE_ELECTRON=1 vite build && electron-builder",
    "electron:dist": "cross-env VITE_ELECTRON=1 vite build && electron-builder --publish never",
    "electron:publish": "cross-env VITE_ELECTRON=1 vite build && electron-builder --publish always",
    "electron:start": "cross-env VITE_ELECTRON=1 vite build && electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "idb-keyval": "6.2.1",
    "lucide-react": "^0.447.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0",
    "web-push": "^3.6.7",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/node": "^22.20.4",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.180.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "2.1.2",
    "wait-on": "^8.0.5",
    "workbox-core": "^7.1.0",
    "workbox-precaching": "^7.1.0"
  },
  "build": {
    "appId": "com.petlink.widget",
    "productName": "PetLink 桌面组件",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "resnet156",
        "repo": "petlink",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.lifestyle",
      "identity": null,
      "artifactName": "PetLink-Desktop-mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "PetLink-Desktop-win.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "PetLink-Desktop-linux.${ext}"
    }
  }
}
