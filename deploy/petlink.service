[Unit]
Description=PetLink collar API and web
After=network.target

[Service]
Type=simple
User=petlink
Group=petlink
WorkingDirectory=/srv/petlink/current
EnvironmentFile=/srv/petlink/shared/server.env
ExecStart=/srv/petlink/venv/bin/uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8091 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/petlink/shared
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
